[Unit]
Description=Deploy CI-approved CyberAlps image
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=cyberalps
Group=cyberalps
SupplementaryGroups=docker
WorkingDirectory=/opt/cyberalps
ExecStart=/usr/bin/python3 /opt/cyberalps/scripts/auto_update.py
TimeoutStartSec=15min
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/cyberalps /var/lib/cyberalps-deploy

[Install]
WantedBy=multi-user.target
